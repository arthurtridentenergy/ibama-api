# ============================================================
# .env.example — Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================


# ------------------------------------------------------------
# 1. Spinergie API
# Endpoint base e chave de acesso à API de rastreamento da
# Spinergie. A chave é obrigatória para consulta de posições AIS.
# ------------------------------------------------------------
SPINERGIE_BASE_URL=https://api.spinergie.com
SPINERGIE_API_KEY=sua_chave_de_api_aqui


# ------------------------------------------------------------
# 2. JWT — JSON Web Tokens
# Segredo utilizado para assinar/verificar tokens de autenticação.
# Recomenda-se uma string aleatória forte (mínimo 32 caracteres).
# O algoritmo padrão é HS256, mas pode ser alterado se necessário.
# ------------------------------------------------------------
JWT_SECRET_KEY=seu_segredo_jwt_super_secreto_aqui
JWT_ALGORITHM=HS256


# ------------------------------------------------------------
# 3. OAuth2 — Credenciais do cliente
# Client ID e Client Secret utilizados na autenticação do tipo
# Client Credentials entre aplicações integradas.
# ------------------------------------------------------------
CLIENT_ID=ibama_client_id
CLIENT_SECRET=seu_client_secret_aqui


# ------------------------------------------------------------
# 4. Plataformas / Unidades monitoradas
# MMSI das plataformas P08 e P65, além das coordenadas-base de
# cada uma (latitude e longitude), usadas para monitoramento e
# cálculo de distância em relação às embarcações próximas.
# ------------------------------------------------------------
P08_MMSI=000000008
P08_LATITUDE=-22.000000
P08_LONGITUDE=-40.000000

P65_MMSI=000000065
P65_LATITUDE=-23.000000
P65_LONGITUDE=-41.000000


# ------------------------------------------------------------
# 5. Logging
# Nível de log da aplicação. Opções comuns:
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# ------------------------------------------------------------
LOG_LEVEL=INFO